    "\n",
    "    elif len(num_cols) == 2:\n",
    "        fig = px.scatter(data, x=num_cols[0], y=num_cols[1], color=cat_cols[0], title=f'{num_cols[0]} vs {num_cols[1]} by {cat_cols[0]}', opacity=0.5)\n",
    "\n",
    "    elif len(num_cols) == 1:\n",
