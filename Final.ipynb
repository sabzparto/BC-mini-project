    "compare_corr = pd.DataFrame()\n",
    "\n",
    "for col in numeric_columns:\n",
    "\n",
    "    stress_corr, stress_p = stats.spearmanr(data[col],data[\"Stress Level (1-10)\"])\n",
    "\n",
    "    anxiety_corr, anxiety_p = stats.spearmanr(data[col],data[\"Anxiety Level (1-10)\"])\n",
    "\n",
    "    if abs(stress_corr) > abs(anxiety_corr):\n",
    "        stronger = \"Stress\"\n",
    "    else:\n",
    "        stronger = \"Anxiety\"\n",
    "\n",
    "    compare_corr.loc[col, \"stress_corr\"] = stress_corr\n",
    "    compare_corr.loc[col, \"anxiety_corr\"] = anxiety_corr\n",
    "    compare_corr.loc[col, \"stronger_relation\"] = stronger\n",
    "\n",
    "compare_corr"
   ]
