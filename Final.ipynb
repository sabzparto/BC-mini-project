   "outputs": [],
   "source": [
    "def nan_percentage(df : pd.DataFrame) -> pd.DataFrame:\n",
    "    total_rows = len(df)\n",
    "    missing_count = [df[col].isna().sum() for col in df.columns]\n",
    "    nan_percentage = [(df[col].isna().sum() / total_rows) * 100 for col in df.columns]\n",
    "    result = pd.DataFrame({'Missing Count': missing_count, 'Nan Percent': nan_percentage}, index=df.columns)\n",
    "    sorted_result = result.sort_values(by ='Nan Percent', ascending = False)\n",
    "    return sorted_result"
   ]
