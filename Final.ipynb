    "    result['NaN_Count'] = nan_count[mask]\n",
    "    result['Total_Issues'] = result['Invalid_Count'] + result['NaN_Count']\n",
    "\n",
    "    print('rows with both NaN and invalid values:', len(result))\n",
    "    return result"
