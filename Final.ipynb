    "def outlier_detector(col, method='iqr', k=1.5, z_thresh=3, clip=False) -> pd.Series:\n",
    "    if method == 'iqr':\n",
    "        q1, q3 = col.quantile(0.25), col.quantile(0.75)\n",
    "        iqr = q3 - q1\n",
    "        lower = q1 - k * iqr\n",
    "        upper = q3 + k * iqr\n",
    "        mask = (col < lower) | (col > upper)\n",
