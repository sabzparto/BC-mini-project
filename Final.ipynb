    "\n",
    "def overview(df, col, target=\"Target\", k=1.5):\n",
    "\n",
    "    #numeric\n",
    "    if col in numeric_columns_pp:\n",
    "\n",
    "        q1, q3 = df[col].quantile([0.25, 0.75])\n",
    "        iqr = q3 - q1\n",
    "        lower, upper = q1 - k * iqr, q3 + k * iqr\n",
    "        n_lower = (df[col] < lower).sum()\n",
    "        n_upper = (df[col] > upper).sum()\n",
    "\n",
    "        stat, p_shapiro = stats.shapiro(df[col])\n",
    "\n",
    "        fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "        fig.suptitle(col, fontsize=14, fontweight='bold')\n",
    "\n",
    "        # Boxplot\n",
    "        sns.boxplot(x=df[col], ax=axes[0], color=Blue, fliersize=4)\n",
    "        axes[0].set_title('Boxplot')\n",
    "        axes[0].text(0.02, 0.9, f'lower: {n_lower}', transform=axes[0].transAxes)\n",
    "        axes[0].text(0.02, 0.8, f'upper: {n_upper}', transform=axes[0].transAxes)\n",
    "\n",
    "        # Histogram\n",
    "        sns.histplot(df[col], kde=True, ax=axes[1], color=Blue, edgecolor='white')\n",
    "        axes[1].set_title('Histogram + KDE')\n",
    "\n",
    "        # QQ plot\n",
    "        stats.probplot(df[col], dist='norm', plot=axes[2])\n",
    "        axes[2].get_lines()[1].set_color(Orange)\n",
    "        axes[2].set_title(f'QQ-plot (p = {p_shapiro:.4f})')\n",
    "\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "    # categorical\n",
    "    else:\n",
    "\n",
    "        fig, axes = plt.subplots(2, 3, figsize=(18, 9), squeeze=False)\n",
    "        fig.suptitle(col, fontsize=14, fontweight='bold')\n",
    "\n",
    "        #heatmaps\n",
    "        percent_table = pd.crosstab(df[col], columns=\"percent\", normalize=True)*100\n",
    "        sns.heatmap(percent_table, annot=True, cmap=soft_coolwarm, cbar=False, ax=axes[0,0])\n",
    "\n",
    "        cont_table = pd.crosstab(df[col], df[target])\n",
    "        sns.heatmap(cont_table, annot=True, fmt='.0f', cmap=soft_coolwarm, cbar=False, ax=axes[0,1])\n",
    "\n",
    "        prop_table = pd.crosstab(df[col], df[target], normalize=\"index\")\n",
    "        sns.heatmap(prop_table, annot=True, fmt='.2%', cmap=soft_coolwarm, cbar=False, ax=axes[0,2])\n",
    "\n",
    "        # plots\n",
    "        order = df[col].value_counts().index\n",
