    "        fig.update_layout(xaxis_tickangle=30)\n",
    "\n",
    "    else:\n",
    "        fig = px.histogram(data, x=var1, color=var2, facet_col=var3, barmode='group', title=f'{var1} by {var2}, split by {var3}')\n",
