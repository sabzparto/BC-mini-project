   "source": [
    "# IQR-based lower/upper bounds for a numeric column\n",
    "def outlier_bounds(data, col, k=1.5):\n",
    "    q1, q3 = data[col].quantile([0.25, 0.75])\n",
    "    iqr = q3 - q1\n",
    "    return q1 - k * iqr, q3 + k * iqr\n",
    "\n",
    "low, high = outlier_bounds(data, 'Caffeine Intake (mg/day)')\n",
    "n_outliers = ((data['Caffeine Intake (mg/day)'] < low) | (data['Caffeine Intake (mg/day)'] > high)).sum()\n",
    "print(f'IQR bounds: [{low:.1f}, {high:.1f}]  ->  {n_outliers} potential outliers')"
   ]
  },
