  {
   "cell_type": "code",
   "execution_count": 446,
   "id": "f53c8d61",
   "metadata": {},
   "outputs": [],
   "source": [
    "def anova_test(data, multi_cat_col, target_col):\n",
    "\n",
    "    groups = []\n",
    "\n",
    "    for group in data[multi_cat_col].unique():\n",
    "\n",
    "        sample = data[data[multi_cat_col] == group][target_col]\n",
    "\n",
    "        groups.append(sample)\n",
    "\n",
    "    f_stat, p = stats.f_oneway(*groups)\n",
    "\n",
    "    if p < 0.05:\n",
    "        result = \"Significant\"\n",
    "    else:\n",
    "        result = \"Not Significant\"\n",
    "\n",
    "    output = pd.DataFrame({\"multi_category\": [multi_cat_col],\n",
    "                          \"target\": [target_col],\n",
    "                          \"F_stat\": f_stat,\n",
    "                          \"P_value\": p,\n",
    "                          \"result\": result})\n",
    "\n",
    "    return output"
   ]
  },
