    "axes = axes.flatten()\n",
    "\n",
    "for ax, c in zip(axes, numeric_columns):\n",
    "    sns.histplot(data[c], kde=True, ax=ax)\n",
    "    ax.axvline(data[c].mean(), color='red', linestyle='--', label='mean')\n",
    "    ax.axvline(data[c].median(), color='green', linestyle='--', label='median')\n",
    "    ax.set_title(c)\n",
    "    ax.legend()\n",
    "\n",
    "for ax in axes[len(numeric_columns):]:\n",
    "    fig.delaxes(ax)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 8))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for ax, c in zip(axes, ordinal_columns):\n",
    "    value_counts = data[c].value_counts().sort_index()\n",
    "    sns.barplot(x=value_counts.index, y=value_counts.values, ax=ax,  color='#4C72B0',)\n",
    "    ax.set_title(c)\n",
    "    ax.set_xlabel('Level')\n",
    "    ax.set_ylabel('Count')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
